[Unit]
Description=Smart Greenhouse Vision Agent
After=greenhouse-backend.service
Wants=greenhouse-backend.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__/RaspberryPi
ExecStart=/usr/bin/python3 __REPO_DIR__/RaspberryPi/vision_agent.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
